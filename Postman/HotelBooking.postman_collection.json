{
  "info": {
    "name": "HotelBooking API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC6: Success Scenario (Books Room 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Booking successfully created (Status 201)\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"startDate\": \"2027-05-01\",\n    \"endDate\": \"2027-05-05\",\n    \"isActive\": true,\n    \"customerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      }
    },
    {
      "name": "Setup: Fill up the hotel (Books Room 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Second room booked successfully (Status 201)\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"startDate\": \"2027-05-01\",\n    \"endDate\": \"2027-05-05\",\n    \"isActive\": true,\n    \"customerId\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      }
    },
    {
      "name": "TC4: Failure Scenario (Hotel is full)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Booking rejected due to full capacity (Status 409)\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"Correct error message returned\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"The booking could not be created. All rooms are occupied.\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"startDate\": \"2027-05-01\",\n    \"endDate\": \"2027-05-05\",\n    \"isActive\": true,\n    \"customerId\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5001"
    }
  ]
}